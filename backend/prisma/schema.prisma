generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  CHECK_IN
  TRIAGE_STARTED
  TRIAGE_COMPLETE
  ALERT
}

enum Severity {
  NORMAL
  HIGH
}

model Event {
  id         String    @id @default(uuid())
  type       EventType
  patientRef String
  message    String
  severity   Severity  @default(NORMAL)
  createdAt  DateTime  @default(now())
}
